#!/bin/bash
# Check every outgoing commit before scheduling any release.
set -euo pipefail
R=$(git rev-parse --show-toplevel)
cd "$R"
remote=$1
updates=$(cat)
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "$local_sha" || "$local_sha" =~ ^0+$ ]] && continue
  commit=$(git rev-parse --verify "$local_sha^{commit}")
  excludes=(--not "--remotes=$remote")
  if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    excludes+=("$remote_sha")
  fi
  commits=$(git rev-list "$commit" "${excludes[@]}")
  # Also check the tip when a new branch or tag points at a commit already on the remote.
  printf '%s\n' "${commits:-$commit}" | xargs -r python3 "$R/release/check-public.py" --commits
done <<< "$updates"

[ "${THUREA_NO_RELEASE:-}" = 1 ] && exit 0
while read -r local_ref local_sha remote_ref _; do
  case "$remote_ref" in refs/heads/main|refs/heads/master) ;; *) continue ;; esac
  [[ "$local_sha" =~ ^0+$ ]] && continue
  LOGDIR=${XDG_STATE_HOME:-$HOME/.local/state}/thurea-release; mkdir -p "$LOGDIR"
  # Wait for the push to land on the remote, then release that exact commit.
  nohup bash -c '
    for i in $(seq 1 120); do
      [ "$(git -C "$1" ls-remote "$2" "$3" 2>/dev/null | cut -f1)" = "$4" ] && exec "$1/release/auto-release.sh" "$4"
      sleep 5
    done
    echo "the push of $4 never showed up on $2: no release"' _ "$R" "$remote" "$remote_ref" "$local_sha" \
    >> "$LOGDIR/auto-release.log" 2>&1 < /dev/null &
  echo "Thurea: releasing ${local_sha:0:7} after the push (log: $LOGDIR/auto-release.log)" >&2
done <<< "$updates"
exit 0
