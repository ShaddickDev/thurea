<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The system splash is just the dark background; Thurea then draws its logo itself. -->
  <style name="Thurea" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@color/bg</item>
    <item name="android:statusBarColor">@color/bg</item>
    <item name="android:navigationBarColor">@color/bg</item>
    <item name="android:windowSplashScreenBackground">@color/bg</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/blank</item>
  </style>
</resources>
