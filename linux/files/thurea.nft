#!/usr/sbin/nft -f
# Thurea: apps can't get around the family DNS with their own DNS server.
# Only the system resolver (systemd-resolved, which uses the family DNS and the hosts block) and
# root may send DNS; for every other app (browsers like Ladybird, Flatpaks…) these are dropped:
#   • plain DNS (port 53) and DNS-over-TLS/QUIC (port 853) to anywhere but this computer;
#   • anything to the well-known public DNS-over-HTTPS servers.
# Cloudflare's family resolver (1.1.1.3 / 1.0.0.3, family.cloudflare-dns.com) is not on the list.
table inet thurea
delete table inet thurea
table inet thurea {
  set doh4 {
    type ipv4_addr; flags interval
    elements = {
      1.1.1.1, 1.0.0.1, 1.1.1.2, 1.0.0.2,                      # Cloudflare (not the family 1.1.1.3)
      104.16.248.249, 104.16.249.249,                          # cloudflare-dns.com, mozilla/chrome.cloudflare-dns.com
      8.8.8.8, 8.8.4.4,                                        # Google
      9.9.9.9, 9.9.9.10, 9.9.9.11, 9.9.9.12,                   # Quad9
      149.112.112.9, 149.112.112.10, 149.112.112.11, 149.112.112.12, 149.112.112.112,
      94.140.14.14, 94.140.15.15, 94.140.14.140, 94.140.14.141, 94.140.14.15, 94.140.15.16,   # AdGuard
      208.67.222.222, 208.67.220.220, 208.67.222.2, 208.67.220.2,                         # OpenDNS
      45.90.28.0/24, 45.90.30.0/24,                            # NextDNS
      76.76.2.0/24, 76.76.10.0/24,                             # Control D
      194.242.2.0/24,                                          # Mullvad DNS
      185.222.222.222, 45.11.45.11,                            # DNS.SB
      101.101.101.101, 101.102.103.104,                        # Quad101
      223.5.5.5, 223.6.6.6, 1.12.12.12, 120.53.53.53,          # AliDNS, DNSPod
      77.88.8.8, 77.88.8.1, 86.54.11.1, 86.54.11.100           # Yandex, DNS4EU
    }
  }
  set doh6 {
    type ipv6_addr; flags interval
    elements = {
      2606:4700:4700::1111, 2606:4700:4700::1001, 2606:4700:4700::1112, 2606:4700:4700::1002,
      2606:4700::6810:f8f9, 2606:4700::6810:f9f9,
      2001:4860:4860::8888, 2001:4860:4860::8844,
      2620:fe::fe, 2620:fe::9, 2620:fe::10, 2620:fe::11, 2620:fe::fe:10, 2620:fe::fe:11,
      2a10:50c0::ad1:ff, 2a10:50c0::ad2:ff, 2a10:50c0::1:ff, 2a10:50c0::2:ff,
      2620:119:35::35, 2620:119:53::53,
      2a07:a8c0::/32, 2a07:a8c1::/32,
      2606:1a40::/32,
      2a07:e340::/32
    }
  }
  chain output {
    type filter hook output priority 0; policy accept;
    oif "lo" accept
    meta skuid { 0, "systemd-resolve" } accept
    ip daddr @doh4 reject
    ip6 daddr @doh6 reject
    meta l4proto { tcp, udp } th dport { 53, 853 } reject
  }
}
