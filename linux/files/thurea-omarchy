#!/bin/bash
# Thurea on Omarchy: Omarea (Thurea's Omarchy app: bar widget, notifications, menu entries,
# keybindings) for every Omarchy user on this computer. Run by the package, and by thurea-apply
# so new users and reinstalled Omarchy get it too. The work itself is `omarea install`, run as
# each user; this only finds the users.
#
#   thurea-omarchy install-all    as root: every user with Omarchy (once per user and version)
#   thurea-omarchy install        as a user: just me (puts Omarea back if I took it out)
#
# A user who ran `omarea uninstall` keeps it that way: install-all leaves them alone.
set -u
OMAREA=${OMAREA:-/usr/lib/thurea/omarea}
VERSION=$(cat /usr/share/thurea/VERSION 2>/dev/null || echo dev)

case "${1:-install}" in
  install) exec bash "$OMAREA" install ;;
  install-user) exec bash "$OMAREA" install --auto ;;
  install-all)
    [ "$(id -u)" = 0 ] || { echo "install-all must run as root" >&2; exit 1; }
    while IFS=: read -r user _ uid _ _ home _; do
      [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home/.config/omarchy" ] || continue
      [ -e "$home/.config/thurea/.omarea-off" ] && continue
      # Already done for this version (and the plugin link is still there on Omarchy 4)?
      if [ "$(cat "$home/.config/thurea/.omarea-installed" 2>/dev/null)" = "$VERSION" ] &&
         { [ -e "$home/.config/omarchy/plugins/thurea.omarea" ] ||
           { [ ! -f /usr/share/omarchy/shell/shell.qml ] && [ ! -f "$home/.local/share/omarchy/shell/shell.qml" ]; }; }; then
        continue
      fi
      runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="/run/user/$uid" \
        PATH="/usr/share/omarchy/bin:$home/.local/share/omarchy/bin:/usr/local/bin:/usr/bin" \
        bash "$OMAREA" install --auto >/dev/null 2>&1 || true
    done < /etc/passwd
    ;;
  *) echo "usage: thurea-omarchy install | install-all" >&2; exit 2 ;;
esac
