#!/usr/bin/python3 -I
"""Thurea self-update for Linux.

Checks the latest release of github.com/ShaddickDev/thurea. A release is only used if its manifest
is signed with Thurea's release key (public half in /usr/share/thurea/release-key.pub.pem), and
the package only if it matches the checksum in that signed manifest; then this distribution's
package manager installs it (pacman on Arch, apt on Debian / Ubuntu, dnf on Fedora).

  thurea-update          check and update (run hourly by thurea-update.timer)
  thurea-update --check  only say whether an update is available
"""
import hashlib, json, os, shutil, subprocess, sys, tempfile, urllib.request

REPO = "ShaddickDev/thurea"
BASE = os.environ.get("THUREA_UPDATE_BASE") or f"https://github.com/{REPO}/releases"
SHARE = os.environ.get("THUREA_SHARE") or "/usr/share/thurea"   # override: tests only
KEY = f"{SHARE}/release-key.pub.pem"


def get(url, limit=500 * 1024 * 1024):
    req = urllib.request.Request(url, headers={"User-Agent": "Thurea-updater"})
    with urllib.request.urlopen(req, timeout=120) as r:
        data = r.read(limit + 1)
    if len(data) > limit:
        raise ValueError(f"{url}: too large")
    return data


def package_manager():
    """(manifest key, install command) for this distribution."""
    if shutil.which("pacman"):
        return "linux", lambda f: ["pacman", "-U", "--noconfirm", f]
    if shutil.which("apt-get") and shutil.which("dpkg"):
        return "linux-deb", lambda f: ["apt-get", "install", "-y", "--allow-downgrades", f]
    if shutil.which("dnf"):
        return "linux-rpm", lambda f: ["dnf", "install", "-y", f]
    return None, None


def version(s):
    return tuple(int(x) for x in str(s).strip().split("."))


def main():
    check_only = "--check" in sys.argv
    have = open(f"{SHARE}/VERSION").read().strip()
    manifest = get(f"{BASE}/latest/download/thurea-manifest.json", 1024 * 1024)
    signature = get(f"{BASE}/latest/download/thurea-manifest.json.sig", 4096)
    with tempfile.TemporaryDirectory(prefix="thurea-update-") as tmp:
        m_path, s_path = f"{tmp}/manifest.json", f"{tmp}/manifest.sig"
        open(m_path, "wb").write(manifest)
        open(s_path, "wb").write(signature)
        ok = subprocess.run(["openssl", "dgst", "-sha256", "-verify", KEY, "-signature", s_path, m_path],
                            capture_output=True).returncode == 0
        if not ok:
            print("The latest release isn't signed with Thurea's key: ignored.")
            return 1
        m = json.loads(manifest)
        if version(m["version"]) <= version(have):
            print(f"Thurea {have} is up to date.")
            return 0
        print(f"Thurea {m['version']} is available (installed: {have}).")
        if check_only:
            return 0
        key, install = package_manager()
        if key is None or key not in m["files"]:
            print("No Thurea package for this distribution's package manager in the release.")
            return 1
        f = m["files"][key]
        data = get(f"{BASE}/download/v{m['version']}/{f['name']}")
        if hashlib.sha256(data).hexdigest() != f["sha256"]:
            print("The download doesn't match the signed checksum: not installed.")
            return 1
        pkg = f"{tmp}/{f['name']}"
        open(pkg, "wb").write(data)
        if os.path.exists("/var/lib/pacman/db.lck"):
            print("pacman is busy; trying again later.")
            return 0
        os.chmod(tmp, 0o755)          # apt reads the package as the _apt user
        os.chmod(pkg, 0o644)
        r = subprocess.run(install(pkg))
        if r.returncode:
            print(f"The package manager could not install Thurea {m['version']} (exit {r.returncode}).")
            return 1
        print(f"Thurea updated to {m['version']}.")
        return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # network down, GitHub unreachable, ...: try again at the next run
        print(f"Update check failed: {e}")
        sys.exit(0)
