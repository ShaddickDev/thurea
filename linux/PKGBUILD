# Thurea for Linux (Arch / Omarchy). Built by release/build.sh, which supplies the shared data
# (extension, block lists, policies, release key) in $THUREA_DATA.
pkgname=thurea
pkgver=1.0.0
pkgrel=1
pkgdesc="Thurea: harmful-site and ad blocker managed by the system (hosts block, family DNS, browser policies, force-installed Thurea extension), self-updating from signed GitHub releases"
arch=(x86_64)
url="https://github.com/ShaddickDev/thurea"
license=(custom)
depends=(systemd e2fsprogs python nftables openssl)
optdepends=('jq: add Thurea to the Omarchy bar when the shell is not running'
            'networkmanager: put the Wi-Fi in the phone-setup QR code'
            'android-tools: set up a phone without resetting it (adb, Wireless debugging)')
install=thurea.install
source=()

package() {
  local data=${THUREA_DATA:?set THUREA_DATA (release/build.sh does)}
  cd "$startdir/files"
  install -Dm755 thurea-apply   "$pkgdir/usr/lib/thurea/thurea-apply"
  install -Dm755 thurea-update  "$pkgdir/usr/lib/thurea/thurea-update"
  install -Dm755 deny-remove    "$pkgdir/usr/lib/thurea/deny-remove"
  install -Dm755 deny-install   "$pkgdir/usr/lib/thurea/deny-install"
  install -Dm755 thurea-omarchy "$pkgdir/usr/lib/thurea/thurea-omarchy"
  install -Dm755 thurea-family-host "$pkgdir/usr/lib/thurea/thurea-family-host"
  install -Dm644 thurea-tray.desktop "$pkgdir/etc/xdg/autostart/thurea-tray.desktop"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/thurea/thurea-update "$pkgdir/usr/bin/thurea-update"
  for u in thurea.service thurea.timer thurea.path thurea-extensions.service thurea-update.service thurea-update.timer thurea-mesh.service; do
    install -Dm644 "$u" "$pkgdir/usr/lib/systemd/system/$u"
  done
  for h in hooks/*.hook; do install -Dm644 "$h" "$pkgdir/usr/share/libalpm/hooks/$(basename "$h")"; done
  install -Dm644 resolved.conf "$pkgdir/usr/share/thurea/resolved.conf"
  install -Dm644 thurea.nft    "$pkgdir/usr/share/thurea/thurea.nft"
  install -Dm644 README        "$pkgdir/usr/share/thurea/README"
  # Omarchy first: Thurea's bar plugin (linked into every Omarchy user's plugins by thurea-omarchy).
  cp -r "$startdir/omarchy-plugin/thurea" "$pkgdir/usr/share/thurea/omarchy-plugin"
  find "$pkgdir/usr/share/thurea/omarchy-plugin" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
  cd "$data"
  # The Rust agent (phone setup by QR, verse of the day, status for the tray apps) and the tray
  # for desktops other than Omarchy, plus the Android app the phone setup serves.
  install -Dm755 thurea      "$pkgdir/usr/bin/thurea"
  install -Dm755 thurea-tray "$pkgdir/usr/bin/thurea-tray"
  install -Dm644 Thurea.apk  "$pkgdir/usr/share/thurea/Thurea.apk"
  install -Dm644 CREDITS.md  "$pkgdir/usr/share/thurea/CREDITS.md"
  install -Dm644 CREDITS.md  "$pkgdir/usr/share/licenses/thurea/CREDITS.md"
  for f in thurea.crx updates.xml hosts-block chromium-policy.json firefox-policies.json extension-id release-key.pub.pem VERSION; do
    install -Dm644 "$f" "$pkgdir/usr/share/thurea/$f"
  done
  install -Dm644 thurea.crx  "$pkgdir/usr/share/thurea/web/thurea.crx"
  # The extension's family helper, for every Chromium-family browser.
  local host
  host=$(printf '{"name":"com.thurea.family","description":"Thurea family helper","path":"/usr/lib/thurea/thurea-family-host","type":"stdio","allowed_origins":["chrome-extension://%s/"]}' "$(cat extension-id)")
  for d in etc/chromium/native-messaging-hosts etc/opt/chrome/native-messaging-hosts etc/opt/edge/native-messaging-hosts etc/brave/native-messaging-hosts; do
    install -dm755 "$pkgdir/$d"
    printf '%s\n' "$host" > "$pkgdir/$d/com.thurea.family.json"
    chmod 644 "$pkgdir/$d/com.thurea.family.json"
  done
  install -Dm644 updates.xml "$pkgdir/usr/share/thurea/web/updates.xml"
}
