# Thurea for Linux (Arch / Omarchy). Built by release/build.sh, which supplies the shared data
# (extension, block lists, policies, release key) in $THUREA_DATA.
pkgname=thurea
pkgver=1.0.7
pkgrel=1
pkgdesc="Thurea: harmful-site and ad blocker managed by the system (hosts block, family DNS, browser policies, force-installed Thurea extension), self-updating from signed GitHub releases"
arch=(x86_64)
url="https://github.com/ShaddickDev/thurea"
license=(MIT)
depends=(systemd e2fsprogs python nftables openssl curl)
optdepends=('ffmpeg: video downloads use it to join video and sound (else Thurea fetches its own copy)'
            'jq: add Thurea to the Omarchy bar when the shell is not running'
            'networkmanager: put the Wi-Fi in the phone-setup QR code'
            'android-tools: set up a phone without resetting it (adb, Wireless debugging)')
install=thurea.install
options=(!debug)
source=()

package() {
  # The file layout is shared with the .deb and .rpm builds (stage.sh).
  "$startdir/stage.sh" "$pkgdir" "${THUREA_DATA:?set THUREA_DATA (release/build.sh does)}" arch
}
